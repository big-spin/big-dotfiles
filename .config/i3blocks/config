[SPOTIFY]
# scroll up -> 4
# scroll down -> 5
# press block to pause, scroll up for next and down for previous song
command=if [ "$BLOCK_BUTTON" = "1" ]; then playerctl --player=spotify play-pause; fi; if [ "$BLOCK_BUTTON" = "4" ]; then playerctl --player=spotify next; fi; if [ "$BLOCK_BUTTON" = "5" ]; then playerctl --player=spotify previous; fi; printf "%s  %s\n" "$(playerctl --player=spotify metadata xesam:title)" "$(playerctl --player=spotify metadata xesam:artist)"
interval=1

[BLUETOOTH]
full_text=bluetooth
command=st -e bluetui

[INTERNET]
full_text=internet
command=st -e nmtui connect

[SOUND]
full_text=sound
command=pavucontrol

[BATTERY]
command=printf "%d%% %s\n" "$(cat /sys/class/power_supply/BAT1/capacity)" "$(cat /sys/class/power_supply/BAT1/status | tr '[:upper:]' '[:lower:]')"
interval=1

[DATE]
command=date "+%d/%m/%Y"
interval=1300

[TIME]
command=date "+%H:%M "
interval=60
